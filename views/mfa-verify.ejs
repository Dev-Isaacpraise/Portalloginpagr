<%- include('partials/header', { title: 'Two-Factor Verification (Step 2)' }) %>

<div class="auth-wrapper">
  <!-- University Branding -->
  <div class="auth-header-strip">
    <div class="institution-seal">FUL</div>
    <div class="auth-header-text">
      <h1>Federal University Lokoja</h1>
      <p>Student Academic Clearance & Credential Verification Portal</p>
    </div>
  </div>

  <div class="auth-card">
    <div class="auth-step-pill">
      <span>Step 2 of 2</span> &bull; <span>Time-based One-Time Password</span>
    </div>

    <h2 class="auth-card-title">Two-Factor Authentication</h2>
    <p class="auth-card-subtitle">
      Enter the 6-digit code generated by your authenticator app for student 
      <strong><%= typeof matricNo !== 'undefined' ? matricNo : username %><% if (typeof fullName !== 'undefined' && fullName) { %> (<%= fullName %>)<% } %></strong>
    </p>

    <!-- Error / Lockout Alerts -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div><%= error %></div>
      </div>
    <% } %>

    <!-- Step 2 Form -->
    <form action="/mfa/verify" method="POST" id="form-mfa-verify">
      <input type="hidden" name="code" id="hidden-otp-code" value="">
      <input type="hidden" name="ticket" id="mfa-ticket" value="<%= typeof ticket !== 'undefined' ? ticket : '' %>">

      <div class="otp-container">
        <div class="otp-digit-group">
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box" autocomplete="one-time-code" autofocus />
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box" />
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box" />
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box" />
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box" />
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box" />
        </div>
      </div>

      <!-- Real-time 30s Countdown Display (Visual nod to TOTP being time-based) -->
      <div class="totp-timer-bar">
        <div class="timer-circle">
          <svg viewBox="0 0 24 24">
            <circle class="timer-bg" cx="12" cy="12" r="9"></circle>
            <circle class="timer-progress" id="totp-progress-circle" cx="12" cy="12" r="9"></circle>
          </svg>
        </div>
        <span>Time Window: Code refreshes in <strong id="totp-countdown-seconds">30s</strong></span>
      </div>

      <button type="submit" class="btn btn-primary btn-block" id="btn-mfa-verify-submit">
        Verify Code &amp; Access Portal &rarr;
      </button>
    </form>

    <!-- Presentation Helper: Simulator for Defense -->
    <div class="demo-helper-card" style="margin-top: var(--space-5);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span><strong>💡 Thesis Presentation Helper:</strong></span>
        <button type="button" class="btn btn-outline btn-sm" id="btn-fill-simulated-token">
          Use Current Token (Test Helper)
        </button>
      </div>
      <p style="margin-top: 5px; font-size: 11.5px; line-height: 1.4; color: var(--color-text-muted);">
        Pre-seeded account secret: <code style="font-family: monospace; font-weight: 600;">JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP</code>. Click above to compute and insert the synchronized RFC 6238 token.
      </p>
    </div>

    <div style="text-align: center; margin-top: var(--space-4); font-size: 13px;">
      <a href="/login" style="color: var(--color-text-muted);">&larr; Back to Step 1 (Sign In)</a>
    </div>

    <!-- Security Footnote -->
    <div class="mfa-security-badge" style="margin-top: var(--space-5);">
      <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Protected by 5-attempt brute-force rate limiter</span>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
